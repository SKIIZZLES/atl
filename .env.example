# Domaine *.myshopify.com du store (pas le domaine personnalisé).
SHOPIFY_STORE_DOMAIN=syue3k-pn.myshopify.com

# Storefront API access token — Shopify Admin > Apps > Develop apps > (créer une app)
# > Configuration > Storefront API > activer les scopes de lecture nécessaires
# (produits, collections, panier) > Installer > révéler le token.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optionnel — version d'API Storefront, par défaut 2025-10.
SHOPIFY_STOREFRONT_API_VERSION=2025-10

# URL publique du site (utilisée pour les métadonnées OG/canonical).
NEXT_PUBLIC_SITE_URL=https://ondenoire.com

    {
      "id": "pas-juste",
      "regex": "(?i)\\b(?:ce n['’]est|c['’]est) pas (?:seulement|juste|que|uniquement) [^.!?\\n]{2,60}[,.;] c['’]est\\b|\\bce n['’]est pas (?:seulement|juste|que|uniquement) [^.!?\\n]{2,60}[,.;] c['’]est\\b",
      "name": "« Ce n'est pas juste X, c'est Y »",
      "fix": "Dis la seule chose que tu veux dire. Supprime la moitié qui sert de décor."
    },
    {
      "id": "non-seulement",
      "regex": "(?i)\\bnon seulement\\b[^.!?\\n]{2,80}\\bmais (?:aussi|également|en plus)\\b",
      "name": "« Non seulement X, mais aussi Y »",
      "fix": "Fais deux phrases, ou garde la moitié la plus forte."
    },
    {
      "id": "pas-une-question-de",
      "regex": "(?i)\\bce n['’]est pas (?:une question|une histoire) de [^.!?\\n]{2,60}[.!,;] c['’]est (?:une question|une histoire) de\\b|\\bil ne s['’]agit pas de [^.!?\\n]{2,60}[.!,;] il s['’]agit de\\b",
      "name": "« Ce n'est pas une question de X. C'est une question de Y. »",
      "fix": "Commence par Y. C'est le retournement qui trahit la machine."
    },
    {
      "id": "le-resultat",
      "regex": "(?im)^\\s*(?:le résultat|la meilleure partie|le plus fou|le piège|le hic|la suite)\\s*\\?\\s*$",
      "name": "Ligne-question rhétorique (« Le résultat ? »)",
      "fix": "Donne la réponse dans la phrase au lieu de mettre en scène une révélation."
    },
    {
      "id": "voici-ce-que",
      "regex": "(?i)\\bvoici ce que (?:j['’]ai|nous avons|on a) appris\\b|\\bce que j['’]ai appris\\s*:",
      "name": "« Voici ce que j'ai appris »",
      "fix": "Dis la leçon. Saute l'annonce."
    },
    {
      "id": "triade",
      "regex": "(?i)\\b[\\w-]+, [\\w-]+,? et [\\w-]+\\.",
      "name": "Triade (trois éléments en rythme)",
      "fix": "Deux éléments ou quatre. Trois, c'est le rythme par défaut de la machine."
    },
